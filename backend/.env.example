# Copiá este archivo como .env y completá los valores.
# NO subas el .env al repositorio (ya está en .gitignore).
# En Render NO hace falta este archivo: las variables se cargan en el panel.

# --- Base de datos ---
# URI de conexión de MongoDB Atlas (Database Access > Connect > drivers)
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster.XXXX.mongodb.net

# --- Administrador del dashboard ---
# Usuario único con acceso a /admin
ADMIN_USERNAME=

# Hash bcrypt de la contraseña. Entre comillas SIMPLES para que el shell
# no intente expandir los signos $ del hash.
# Generalo con:
#   htpasswd -bnBC 10 "" TU_CONTRASENA | tr -d ':\n'
ADMIN_PASSWORD=

# --- Sesión ---
# Clave para firmar los JWT del admin. Valor largo y aleatorio.
# En Render se genera automáticamente (generateValue: true).
JWT_SECRET=

# --- CORS ---
# Orígenes del frontend separados por coma. Acepta con o sin https://.
# Vacío o ausente = permitir cualquier origen (solo desarrollo).
# En Render se completa solo con el hostname del sitio estático.
ALLOWED_ORIGINS=http://localhost:4200

# --- Puerto ---
# Render lo inyecta automáticamente. Solo para desarrollo local.
PORT=8080